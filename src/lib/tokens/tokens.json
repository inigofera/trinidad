      "stone-200": { "$value": "#eae3d1", "$type": "color", "$description": "Muted stone fill" },
      "stone-300": {
        "$value": "#dad2be",
        "$type": "color",
        "$description": "Hairline stone border"
      },
      "forest-900": {
        "$value": "#24422a",
        "$type": "color",
        "$description": "Deep forest primary ink"
      },
      "olive-600": {
        "$value": "#5c744e",
        "$type": "color",
        "$description": "Muted olive metadata ink"
      },

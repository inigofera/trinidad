{
  "primitive": {
    "color": {
      "cream-50": {
        "$value": "#fcf9f3",
        "$type": "color",
        "$description": "Elevated warm card surface"
      },
      "cream-100": {
        "$value": "#f8f3e7",
        "$type": "color",
        "$description": "Primary unbleached canvas"
      },
      "stone-200": { "$value": "#eae3d1", "$type": "color", "$description": "Muted stone fill" },
      "stone-300": {
        "$value": "#dad2be",
        "$type": "color",
        "$description": "Hairline stone border"
      },
      "forest-900": {
        "$value": "#24422a",
        "$type": "color",
        "$description": "Deep forest primary ink"
      },
      "olive-600": {
        "$value": "#5c744e",
        "$type": "color",
        "$description": "Muted olive metadata ink"
      },
      "lime-400": {
        "$value": "#a6c856",
        "$type": "color",
        "$description": "Electric chartreuse interactive accent"
      },
      "slate-950": {
        "$value": "#0d1310",
        "$type": "color",
        "$description": "Industrial dark canvas"
      },
      "slate-900": {
        "$value": "#151e19",
        "$type": "color",
        "$description": "Industrial dark elevated card"
      },
      "slate-800": {
        "$value": "#1f2d25",
        "$type": "color",
        "$description": "Industrial dark muted surface"
      },
      "crimson-400": {
        "$value": "#f87171",
        "$type": "color",
        "$description": "Light crimson for industrial dark theme WCAG AA"
      },
      "crimson-500": {
        "$value": "#d9383a",
        "$type": "color",
        "$description": "Critical error status"
      },
      "crimson-700": {
        "$value": "#b91c1c",
        "$type": "color",
        "$description": "Deep crimson for paper light theme WCAG AA"
      },
      "amber-500": {
        "$value": "#e59934",
        "$type": "color",
        "$description": "Warning threshold status"
      },
      "amber-800": {
        "$value": "#9a580a",
        "$type": "color",
        "$description": "Deep amber warning status for paper theme WCAG AA"
      },
      "emerald-500": {
        "$value": "#2ca568",
        "$type": "color",
        "$description": "Nominal telemetry status"
      },
      "emerald-700": {
        "$value": "#15803d",
        "$type": "color",
        "$description": "Deep emerald nominal status for paper theme WCAG AA"
      },
      "olive-700": {
        "$value": "#4b603f",
        "$type": "color",
        "$description": "Deep olive metadata ink for paper theme WCAG AA"
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Pure white"
      }
    },
    "font": {
      "sans": { "$value": "'Space Grotesk', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'Space Mono', monospace", "$type": "fontFamily" }
    },
    "dimension": {
      "radius-card": {
        "$value": "10px",
        "$type": "dimension",
        "$description": "Card/surface corner radius (mi.com dominant 8-10px scale)"
      },
      "radius-control": {
        "$value": "8px",
        "$type": "dimension",
        "$description": "Button/input corner radius (mi.com --btn-border-radius: 8px)"
      }
    }
  },
  "semantic": {
    "paper": {
      "surface-canvas": { "$value": "{primitive.color.cream-100}", "$type": "color" },
      "surface-elevated": { "$value": "{primitive.color.cream-50}", "$type": "color" },
      "surface-muted": { "$value": "{primitive.color.stone-200}", "$type": "color" },
      "fg-primary": { "$value": "{primitive.color.forest-900}", "$type": "color" },
      "fg-muted": { "$value": "{primitive.color.olive-700}", "$type": "color" },
      "border-subtle": { "$value": "{primitive.color.stone-300}", "$type": "color" },
      "accent-interactive": { "$value": "{primitive.color.lime-400}", "$type": "color" },
      "status-critical": { "$value": "{primitive.color.crimson-700}", "$type": "color" },
      "status-warning": { "$value": "{primitive.color.amber-800}", "$type": "color" },
      "status-nominal": { "$value": "{primitive.color.emerald-700}", "$type": "color" },
      "brand-primary": { "$value": "{primitive.color.forest-900}", "$type": "color" }
    },
    "industrial": {
      "surface-canvas": { "$value": "{primitive.color.slate-950}", "$type": "color" },
      "surface-elevated": { "$value": "{primitive.color.slate-900}", "$type": "color" },
      "surface-muted": { "$value": "{primitive.color.slate-800}", "$type": "color" },
      "fg-primary": { "$value": "{primitive.color.cream-50}", "$type": "color" },
      "fg-muted": { "$value": "{primitive.color.stone-300}", "$type": "color" },
      "border-subtle": { "$value": "{primitive.color.olive-600}", "$type": "color" },
      "accent-interactive": { "$value": "{primitive.color.lime-400}", "$type": "color" },
      "status-critical": { "$value": "{primitive.color.crimson-400}", "$type": "color" },
      "status-warning": { "$value": "{primitive.color.amber-500}", "$type": "color" },
      "status-nominal": { "$value": "{primitive.color.emerald-500}", "$type": "color" },
      "brand-primary": { "$value": "{primitive.color.white}", "$type": "color" }
    }
  },
  "density": {
    "comfortable": {
      "control-height": { "$value": "2.25rem", "$type": "dimension" },
      "control-px": { "$value": "0.75rem", "$type": "dimension" },
      "control-py": { "$value": "0.5rem", "$type": "dimension" },
      "row-height": { "$value": "2.5rem", "$type": "dimension" },
      "font-size-ui": { "$value": "0.875rem", "$type": "dimension" },
      "gap-ui": { "$value": "0.5rem", "$type": "dimension" }
    },
    "compact": {
      "control-height": { "$value": "1.75rem", "$type": "dimension" },
      "control-px": { "$value": "0.5rem", "$type": "dimension" },
      "control-py": { "$value": "0.25rem", "$type": "dimension" },
      "row-height": { "$value": "1.75rem", "$type": "dimension" },
      "font-size-ui": { "$value": "0.75rem", "$type": "dimension" },
      "gap-ui": { "$value": "0.25rem", "$type": "dimension" }
    }
  }
}

      "6xl": { "$value": "3.75rem", "$type": "fontSize", "$description": "Portfolio hero headline" }
    },
    "line-height": {
      "tight": {
        "$value": "1.15",
        "$type": "dimension",
        "$description": "Display heading line-height"
      },
      "snug": {
        "$value": "1.3",
        "$type": "dimension",
        "$description": "Section subhead line-height"
      },
      "normal": {
        "$value": "1.5",
        "$type": "dimension",
        "$description": "Standard UI text line-height"
      },
      "relaxed": {
        "$value": "1.65",
        "$type": "dimension",
        "$description": "Long-form editorial reading line-height"
      }
    },
    "aspect-ratio": {
      "video": {
        "$value": "16 / 9",
        "$type": "dimension",
        "$description": "Standard widescreen video/media"
      },
      "wide": {
        "$value": "21 / 9",
        "$type": "dimension",
        "$description": "Cinematic banner ratio"
      },
      "photo": {
        "$value": "4 / 3",
        "$type": "dimension",
        "$description": "Editorial UI photo ratio"
      },
      "square": {
        "$value": "1 / 1",
        "$type": "dimension",
        "$description": "Icon / square tile ratio"
      }
    },
    "shadow": {
      "subtle": {
        "$value": "0 1px 3px rgba(0, 0, 0, 0.05)",
        "$type": "shadow",
        "$description": "Subtle tactile elevation"
      },
      "floating": {
        "$value": "0 8px 24px -4px rgba(0, 0, 0, 0.12)",
        "$type": "shadow",
        "$description": "Floating overlay / modal shadow"
      }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "spacing", "$description": "4px hairline spacing" },
      "2": { "$value": "0.5rem", "$type": "spacing", "$description": "8px tight spacing" },
      "3": { "$value": "0.75rem", "$type": "spacing", "$description": "12px standard gap" },
      "4": { "$value": "1rem", "$type": "spacing", "$description": "16px section gap" },
      "5": { "$value": "1.25rem", "$type": "spacing", "$description": "20px loose gap" },
      "6": { "$value": "1.5rem", "$type": "spacing", "$description": "24px component gap" },
      "8": { "$value": "2rem", "$type": "spacing", "$description": "32px page gap" },
      "10": { "$value": "2.5rem", "$type": "spacing", "$description": "40px wide gap" },
      "12": { "$value": "3rem", "$type": "spacing", "$description": "48px major section gap" },
      "16": { "$value": "4rem", "$type": "spacing", "$description": "64px max gap" }
    },
    "dimension": {
      "radius-card": {
        "$value": "10px",
        "$type": "dimension",
        "$description": "Card/surface corner radius (mi.com dominant 8-10px scale)"
      },
      "radius-control": {
        "$value": "8px",
        "$type": "dimension",
        "$description": "Button/input corner radius (mi.com --btn-border-radius: 8px)"
      }

        "$value": "#ffffff",
        "$type": "color",
        "$description": "Pure white"
      }
    },
    "font": {
      "sans": {
        "$value": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Open-source (MIT) geometric-humanist sans via @fontsource/manrope — closest widely-available lookalike to the mi.com aesthetic; weights 400/500/700"
      },
      "mono": {
        "$value": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Intentionally aliased to primitive.font.sans — single-face typography (Space Mono retired Phase 9); keep in sync with sans"
      }
    },
    "font-weight": {
      "regular": { "$value": 400, "$type": "fontWeight", "$description": "Regular text weight" },
      "medium": { "$value": 500, "$type": "fontWeight", "$description": "Medium text weight" },
      "bold": { "$value": 700, "$type": "fontWeight", "$description": "Bold text weight" }
    },
    "font-size": {
      "xs": { "$value": "0.75rem", "$type": "fontSize", "$description": "Caption / micro type" },
      "sm": { "$value": "0.875rem", "$type": "fontSize", "$description": "Small UI text" },
      "base": { "$value": "1rem", "$type": "fontSize", "$description": "Default body text" },
      "lg": {
        "$value": "1.125rem",
        "$type": "fontSize",
        "$description": "Large body / small heading"
